# Supabase project URL — find it in your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key — find it in your Supabase project settings > API
VITE_SUPABASE_KEY=your-anon-key

# Optional: base URL for map images. Unset in dev (served from /maps).
# In production set to the Supabase Storage public URL after uploading maps:
#   <SUPABASE_URL>/storage/v1/object/public/maps
VITE_MAPS_BASE_URL=
