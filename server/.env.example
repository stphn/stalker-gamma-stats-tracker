# Path to the JSON file written by the Lua mod
STATS_FILE=C:/anomaly/appdata/gamma_stats.json

# Supabase project URL — find it in your Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key — find it in your Supabase project settings > API
SUPABASE_KEY=your-anon-key

# Supabase secret key — needed ONLY to run scripts/upload-maps.mjs (Storage write).
# Supabase → Settings → API keys → secret key (sb_secret_…). Do not ship to client.
SUPABASE_SECRET_KEY=your-secret-key
