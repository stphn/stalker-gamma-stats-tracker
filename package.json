{
  "name": "stralker",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "decode-dxt": "^1.0.1",
    "parse-dds": "^1.2.1"
  },
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"bun run --cwd server dev\" \"bun run --cwd client dev\"",
