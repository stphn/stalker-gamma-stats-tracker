-- stats_tracker.script
-- Tracks kills, deaths, tasks, economy, and achievements.
-- Writes gamma_stats.json (website feed) and gamma_persistent.lua (alltime across saves).

local alltime      = {}
local session      = {}
local run_history  = {}  -- last 3 sessions that ended in a death (newest first)
local unlocked     = {}  -- our custom achievements
local game_ach     = {}  -- native game achievements

local alltime_base_playtime  = 0
local session_start          = 0
local last_money             = 0
local last_pos               = nil  -- actor position at last tick (for distance walked)
local last_stash_seen        = 0  -- session.stashes at last tick (to re-check the stash achievement)
-- Per-tick distance over this cap (metres) is treated as a teleport/level change
-- and discarded. At a 500ms feed tick even sprinting stays well under this.
local DIST_CAP               = 50
local last_save_tick         = 0
local last_persist_tick      = 0
local skip_first_load_screen = true
local is_loading             = true
local needs_seeding          = false  -- true on very first run (no persistent file)
local session_ended          = false  -- true after death so load_state starts fresh

-- Website feed (gamma_stats.json) is written often for a smooth live map;
-- persistence (gamma_persistent.lua) is heavier so it's saved less frequently
-- (events like kills/deaths/tasks still persist immediately via their callbacks).
local FEED_INTERVAL_MS    = 500
local PERSIST_INTERVAL_MS = 5000

-- Zone news: curated in-game tips captured for the website feed.
-- Volatile per session (newest first). Curated by raw caption key (language-
-- independent) so only world events surface, not every barker/UI nag.
local news_buf   = {}
local NEWS_MAX   = 30
-- Discovery mode: false = capture every tip (so we can see the real caption
-- keys), true = keep only the curated categories in NEWS_MATCH below.
local NEWS_CURATE = false
-- Loot capture: true = push every item pickup ("Looted X") into the feed.
-- Pickups don't go through news_manager.send_tip, so they're captured straight
-- from the actor_on_item_take callback instead. Toggle off once curated.
local NEWS_LOOT   = true
local NEWS_MATCH = {
    "surge", "emission", "psy", "psi",                  -- blowouts / psi-storms
    "warfare", "domination", "territory", "captured",   -- warfare / faction control
    "promot", "rank_up",                                -- promotions
    "achievement",                                       -- unlocks
}

-- ============================================================
-- Data initializers
-- ============================================================

local function new_kills()
    return {
        total=0,
        stalker=0, bandit=0, military=0,
        freedom=0, duty=0, ecolog=0, csky=0,
        monolith=0, killer=0, renegade=0,
        mutant=0, helicopter=0, other=0,
    }
end

local function new_alltime()
    return {
        kills         = new_kills(),
        deaths        = 0,
        tasks         = 0,
        rubles_earned = 0,
        rubles_spent  = 0,
        artifacts     = 0,
        items         = 0,
        stashes       = 0,
        level_changes = 0,
        playtime      = 0,
        -- Cross-save richer fields (carried from the native PDA counters via the
        -- same baseline/delta model as stashes; see update_native_accumulators).
        distance_m          = 0,  -- metres walked
        zone_days           = 0,  -- in-game days survived
        levels_visited      = 0,
        tasks_failed        = 0,
        tasks_cancelled     = 0,
        pdas_delivered      = 0,
        articles            = 0,
        emissions           = 0,
        psi_storms          = 0,
        field_dressings     = 0,
        wounded_helped      = 0,
        boxes_smashed       = 0,
        enemies_surrendered = 0,
    }
end

local function new_session()
    local t = new_alltime()
    t.start = os.time()
    return t
end

local function backfill(tbl, defaults)
    for k, v in pairs(defaults) do
        if tbl[k] == nil then tbl[k] = v end
    end
end

