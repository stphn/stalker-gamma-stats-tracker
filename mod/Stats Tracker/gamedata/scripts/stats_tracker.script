    { id="killer_100",    name="Hunter",          desc="Kill 100 enemies",               check=function(a) return a.kills.total >= 100    end },
    { id="killer_500",    name="Executioner",     desc="Kill 500 enemies",               check=function(a) return a.kills.total >= 500    end },
    { id="killer_1000",   name="Butcher",         desc="Kill 1,000 enemies",             check=function(a) return a.kills.total >= 1000   end },
    { id="mutant_50",     name="Mutant Hunter",   desc="Kill 50 mutants",                check=function(a) return a.kills.mutant >= 50    end },
    { id="bandit_50",     name="Bandit Hunter",   desc="Kill 50 bandits",                check=function(a) return a.kills.bandit >= 50    end },
    { id="military_50",   name="Army Slayer",     desc="Kill 50 military",               check=function(a) return a.kills.military >= 50  end },
    { id="first_death",   name="Zone Tax",        desc="Die for the first time",         check=function(a) return a.deaths >= 1           end },
    { id="deaths_10",     name="Nine Lives",      desc="Die 10 times and keep going",    check=function(a) return a.deaths >= 10          end },
    { id="task_1",        name="On the Job",      desc="Complete your first task",       check=function(a) return a.tasks >= 1            end },
